{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*", "scripts/**/*", "token-mint/**/*", "counter/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "**/compiled", "**/zkir", "**/keys"],
  "references": [
    { "path": "../../../packages/midnight-core" },
    { "path": "../../../packages/midnight-node" },
    { "path": "../../../packages/client" }
  ]
}
