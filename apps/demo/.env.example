# Read by the dev server only, which inlines them into the page's config. Built
# bundles take their network at deploy from scripts/interpolate-index.ts and every
# URL from that network's defaults.

# Network the page is configured for
#NETWORK_ID=preview

# Capacity Exchange Server
# TODO: This should be a list
CAPACITY_EXCHANGE_URL=http://localhost:3000

# Proof server
#PROOF_SERVER_URL=

# Enable mocked demo flow that skips wallet / contract dependencies
#MOCK_DEMO_MODE=true
