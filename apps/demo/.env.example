# Read by the dev server only, which inlines them into the page's config. Built
# bundles take theirs at deploy from scripts/interpolate-index.ts, and any URL left
# unset falls back to the network's defaults.

# Network the page is configured for
#NETWORK_ID=preview

# Capacity Exchange Server
# TODO: This should be a list
CAPACITY_EXCHANGE_URL=http://localhost:3000

# Proof server
#PROOF_SERVER_URL=

# Indexer (set both or neither). Any query string is kept, e.g. a Blockfrost project_id.
#INDEXER_URL=https://midnight-preprod.blockfrost.io/api/v0?project_id=
#INDEXER_WS_URL=wss://midnight-preprod.blockfrost.io/api/v0/ws?project_id=

# Enable mocked demo flow that skips wallet / contract dependencies
#MOCK_DEMO_MODE=true
