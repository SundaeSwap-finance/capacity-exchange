# The Cardano-only server the Cardano e2e tests run against: no DUST is priced, so
# no Midnight network is set up. Start the devnet with testnet/cardano.yml.

# Server
PORT=3000
LOG_LEVEL=debug
NODE_ENV=dev

# Offer Management
QUOTE_TTL_SECONDS=300
QUOTE_SECRET_FILE=./.quote-secret.test.key
OFFER_TTL_SECONDS=2
PRICE_CONFIG_FILE=price-config.cardano-test.json

# Cardano devnet
CARDANO_UTXORPC_URL=http://127.0.0.1:50051
# testnet/cardano/server.addr; the devnet node holds no funds for it until a test pays it.
CARDANO_WALLET_ADDRESS=addr_test1vzxtav7k76x0523castslppm64kvygpt2wpmyg7l4ggegqsgmh0e8
