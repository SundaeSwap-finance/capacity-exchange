{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src/",
    "strict": true,
    "module": "nodenext",
    "target": "es2022",
    "lib": ["ES2023"],
    "moduleResolution": "nodenext",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
