{
  "name": "@sundaeswap/capacity-exchange-registry-nodejs",
  "version": "3.0.1",
  "private": true,
  "description": "Registry utilities for the capacity exchange SDK",
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "generate-secret": "bun src/cli/generate-secret-key.ts",
    "deploy": "bun src/cli/deploy.ts",
    "register": "bun src/cli/register.ts",
    "deregister": "bun src/cli/deregister.ts",
    "claim-expired": "bun src/cli/claim-expired.ts",
    "renew-registration": "bun src/cli/renew-registration.ts",
    "list-servers": "bun src/cli/list-registered-servers.ts"
  },
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@sundaeswap/capacity-exchange-core": "workspace:^",
    "@sundaeswap/capacity-exchange-nodejs": "workspace:^",
    "@sundaeswap/capacity-exchange-registry": "workspace:^",
    "commander": "^14.0.2",
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/ledger-v9": "1.0.1",
    "@midnight-ntwrk/midnight-js": "5.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnight-ntwrk/wallet-sdk": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
