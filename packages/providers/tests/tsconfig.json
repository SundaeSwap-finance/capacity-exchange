{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2020",
    "allowJs": true,
    "declaration": false,
    "rootDir": "..",
    "paths": {
      "@/*": ["../src/*"]
    },
    "noEmit": true,
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["./**/*.ts", "../src/**/*.ts"],
  "references": [{ "path": "../../midnight-core" }, { "path": "../../client" }, { "path": "../../registry" }]
}
