{
  "name": "@sundaeswap/capacity-exchange-core",
  "version": "2.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "bun": "./src/seed.ts",
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "publish:prod": "bun publish --tolerate-republish"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.1.0",
    "@midnight-ntwrk/midnight-js": "5.0.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/wallet-sdk": "2.0.0",
    "@scure/bip39": "^2.0.1",
    "rxjs": "^7.5",
    "graphql": "^17.0.1"
  },
  "devDependencies": {
    "@midnightntwrk/ledger-v9": "1.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@midnightntwrk/ledger-v9": "1.0.0"
  }
}
